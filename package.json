{
  "name": "backend-cloud-editor",
  "version": "0.3.0",
  "description": "Mini CRM MVP",
  "author": "Evgeniy Zotov",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && yarn build:migrations",
    "build:migrations": "tsc migrations/*.ts --outDir dist/migrations --target ES2023 --module nodenext --skipLibCheck",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "cross-env NODE_ENV=development nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "migration:data-source": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d ./src/configs/db/data-source.ts",
    "migration:data-source:prod": "cross-env NODE_ENV=production node ./node_modules/typeorm/cli.js -d ./dist/configs/db/data-source.js",
    "migration:generate": "yarn migration:data-source migration:generate",
    "migration:run": "yarn migration:data-source migration:run",
    "migration:revert": "yarn migration:data-source migration:revert",
    "migration:run:prod": "yarn migration:data-source:prod migration:run",
    "migration:revert:prod": "yarn migration:data-source:prod migration:revert"
  },
  "dependencies": {
    "@nestjs-modules/ioredis": "^2.3.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/mail": "^0.0.2",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.0.1",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/typeorm": "^11.0.2",
    "@nestjs/websockets": "^11.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "piscina": "^5.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "typeorm": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/fluent-ffmpeg": "^2",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/passport": "^0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8",
    "@types/supertest": "^7.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.2",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "packageManager": "yarn@4.17.0"
}
